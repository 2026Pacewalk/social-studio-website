# Copy to .env and fill in. Never commit .env.
PORT=4000

# Secret used to sign login tokens — set to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# First admin account (created on first run if no users exist).
ADMIN_NAME=Sukhjeet Singh Brar
ADMIN_EMAIL=Sukhjeetbrar@socialtheory.in
ADMIN_PASSWORD=changeme123

# Where lead alert emails are sent (comma-separated).
LEAD_ALERT_TO=Sukhjeetbrar@socialtheory.in,Kajal@socialtheory.in

# SMTP for lead alert emails (optional — leave blank to disable email; leads are still saved).
# For Zoho: host=smtp.zoho.in, port=465, secure=true, user=your full email, pass=an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Social Studios <Sukhjeetbrar@socialtheory.in>"

# Public origin (for CORS in production); leave blank to allow same-origin only.
CORS_ORIGIN=
